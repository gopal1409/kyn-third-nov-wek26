##create a new folder in desktop called as call-module
  ##open a new visual studio code click on open folder select the call-module from desktop
  ##inside that create a file called as variables.tf copy from line 4 till 88
  variable "project_name" {
  description = "Project name used as a resource name prefix."
  type        = string
  default     = "sap"
}


variable "environment" {
  description = "Deployment environment."
  type        = string
}

variable "resource_group_name" {
  description = "Suffix used in the resource group name."
  type        = string
  default     = "gopal_rg"
}

variable "location" {
  description = "Azure region."
  type        = string
  default     = "eastus"
}

variable "vnet_name" {
  description = "Virtual network name suffix."
  type        = string
  default     = "gopal-network"
}

variable "vnet_address_space" {
  description = "Virtual network CIDR ranges."
  type        = list(string)
  default     = ["10.0.0.0/16"]
}

variable "subnet_name" {
  description = "Subnet name suffix."
  type        = string
  default     = "web-subnet"
}

variable "subnet_address_prefixes" {
  description = "Subnet CIDR ranges."
  type        = list(string)
  default     = ["10.0.1.0/24"]
}

variable "instance" {
  description = "Map of VM names to size and Availability Zone."
  type = map(object({
    size              = string
    availability_zone = string
  }))
}

variable "ssh_public_key_path" {
  description = "Path to the SSH public key file on the workstation running Terraform."
  type        = string
  default     = "~/.ssh/id_rsa.pub"
}

variable "ssh_source_address_prefix" {
  description = "Trusted source CIDR for SSH, e.g. 203.0.113.10/32. Replace before deployment."
  type        = string
  default     = "0.0.0.0/0"
}

variable "admin_username" {
  description = "Linux VM administrator username."
  type        = string
  default     = "azureuser"
}

variable "lb_frontend_port" {
  description = "Load balancer frontend TCP port."
  type        = number
  default     = 80
}

variable "lb_backend_port" {
  description = "Backend VM TCP port."
  type        = number
  default     = 80
}

#create a file called as output.tf copu from line 91 till 99
  output "resource_group_name" {
  description = "Name of the resource group."
  value       = module.networking.resource_group_name
}

output "location" {
  description = "Location of the resource group."
  value       = module.networking.location
}

#create a file called as dev.tfvars change my name to your name copy from 103 till 119
  
project_name = "sap"
environment = "dev"
resource_group_name = "gopal-rg"
location = "eastus"
vnet_name = "sap-vnet"
vnet_address_space = ["10.0.0.0/16"]    
subnet_name = "sap-subnet"
subnet_address_prefixes = ["10.0.1.0/24"]
instance = {
  "sap-vm" = {
    size              = "Standard_B2s"
    availability_zone = "1"
  }
}
ssh_public_key_path = "~/.ssh/id_rsa.pub"
ssh_source_address_prefix = "0.0.0.0/0"
admin_username = "azureuser"

  #create a file main.tf copy from 122 till 142
  locals {
    name_prefix = "${var.project_name}-${var.environment}"
    project_tags = {
        Project     = var.project_name
        Environment = var.environment
        ManagedBy   = "Terraform"
    }
}

module "networking" {
    source              = "github.com/gopal1409/terraform-module-nov-second26/modules/networking"
    name_prefix        = local.name_prefix
    resource_group_name = var.resource_group_name
    location            = var.location
    vnet_name          = var.vnet_name
    vnet_address_space  = var.vnet_address_space
    subnet_name         = var.subnet_name
    subnet_address_prefixes = var.subnet_address_prefixes
    ssh_source_address_prefix = var.ssh_source_address_prefix
    tags                = local.project_tags
}

#create a file provider.tf copy from 145 till 158
terraform {
  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "=5.0.0" #important for production environment
    }
  }
}

# Configure the Microsoft Azure Provider
provider "azurerm" {
  features {}

}

