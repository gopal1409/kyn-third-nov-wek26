2. Terraform project structure
terraform-aks/
│
├── provider.tf
├── variables.tf
├── main.tf
├── outputs.tf
└── terraform.tfvars


3. provider.tf
Use AzureRM provider version 5.0.0, consistent with your earlier Azure Terraform exercises.
terraform {
  required_version = ">= 1.5.0"

  required_providers {
    azurerm = {
      source  = "hashicorp/azurerm"
      version = "= 5.0.0"
    }
  }
}

provider "azurerm" {
  features {}
}


4. variables.tf
variable "resource_group_name" {
  description = "Azure resource group name"
  type        = string
  default     = "rg-kyn-aks"
}

variable "location" {
  description = "Azure region"
  type        = string
  default     = "eastus"
}

variable "aks_cluster_name" {
  description = "AKS cluster name"
  type        = string
  default     = "kyn-aks-cluster"
}

variable "kubernetes_version" {
  description = "Kubernetes version; null uses the Azure recommended version"
  type        = string
  default     = null
}

variable "system_node_count" {
  description = "Initial number of system nodes"
  type        = number
  default     = 2
}

variable "user_node_count" {
  description = "Initial number of application nodes"
  type        = number
  default     = 2
}

variable "vm_size" {
  description = "Azure VM size for AKS nodes"
  type        = string
  default     = "Standard_D2s_v5"
}

variable "environment" {
  type    = string
  default = "dev"
}


5. main.tf – Create AKS cluster
This configuration creates the resource group and AKS cluster with a system node pool.
resource "azurerm_resource_group" "aks_rg" {
  name     = var.resource_group_name
  location = var.location

  tags = {
    Environment = var.environment
    Project     = "KYN-AKS"
    ManagedBy   = "Terraform"
  }
}

resource "azurerm_kubernetes_cluster" "aks" {

  name                = var.aks_cluster_name
  location            = azurerm_resource_group.aks_rg.location
  resource_group_name = azurerm_resource_group.aks_rg.name

  dns_prefix = "kynaks"

  kubernetes_version = var.kubernetes_version

  # Managed identity
  identity {
    type = "SystemAssigned"
  }

  # System node pool
  default_node_pool {
    name       = "systempool"
    vm_size    = var.vm_size
    node_count = var.system_node_count

    type = "VirtualMachineScaleSets"

    auto_scaling_enabled = true
    min_count            = 2
    max_count            = 3

    max_pods = 30

    os_disk_size_gb = 64
  }

  # Kubernetes networking
  network_profile {
    network_plugin    = "azure"
    load_balancer_sku = "standard"
  }

  role_based_access_control_enabled = true

  tags = {
    Environment = var.environment
    Project     = "KYN-AKS"
    ManagedBy   = "Terraform"
  }

  # The cluster autoscaler manages node_count after creation.
  lifecycle {
    ignore_changes = [
      default_node_pool[0].node_count
    ]
  }
}


6. Create an additional user node pool
This is an important concept in AKS. You can create multiple node pools for different workloads.

Add the following resource to main.tf:
resource "azurerm_kubernetes_cluster_node_pool" "user_pool" {

  name                  = "userpool"
  kubernetes_cluster_id = azurerm_kubernetes_cluster.aks.id

  vm_size    = var.vm_size
  node_count = var.user_node_count

  mode = "User"

  auto_scaling_enabled = true

  min_count = 1
  max_count = 4

  max_pods = 30

  os_disk_size_gb = 64

  tags = {
    Environment = var.environment
    NodePool     = "Application"
  }

  lifecycle {
    ignore_changes = [
      node_count
    ]
  }
}


Understanding the two node pools
Property	System pool	User pool
Name	systempool	userpool
Initial nodes	2	2
Minimum nodes	2	1
Maximum nodes	3	4
VM size	Standard_D2s_v5	Standard_D2s_v5
Workload	Kubernetes system components	Application workloads
Autoscaling	Enabled	Enabled

Initial deployment: 4 nodes
The cluster starts with four worker nodes in total. Autoscaling can change the number of nodes within the configured limits.

Microsoft recommends at least three system nodes for production workloads; two here is a smaller demonstration configuration. 
